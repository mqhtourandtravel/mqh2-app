NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_NOMOR_WA=6285868969000
NEXT_PUBLIC_SITE_URL=https://mqhtourandtravel.com
NEXT_PUBLIC_HERO_IMG=https://images.unsplash.com/your-image-url
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Prisma CLI/database access. Put same values in .env.
DATABASE_URL=postgresql://user:***@pooler-host:6543/postgres
DIRECT_URL=postgresql://user:***@direct-host:5432/postgres

# Auth — email yang boleh akses /api/admin/* (pisah koma).
# WAJIB di Vercel. Kosong = semua user Supabase Auth bisa akses admin.
ADMIN_EMAILS=admin@example.com

# Auth — role default user baru (jamaah | staff_admin | agen).
# Biasanya tidak perlu di-set, default 'jamaah' sudah benar.
# DEFAULT_ROLE=jamaah
