generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Maskapai {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama          String
  logoUrl       String?         @map("logo_url")
  keberangkatan Keberangkatan[]

  @@map("maskapai")
}

model Hotel {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama                 String
  kota                 String
  googleMapsUrl        String?         @map("google_maps_url")
  keberangkatanMadinah Keberangkatan[] @relation("HotelMadinah")
  keberangkatanMekkah  Keberangkatan[] @relation("HotelMekkah")

  @@map("hotel")
}

model Paket {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String          @unique
  namaPaket     String          @map("nama_paket")
  kategori      String
  tier          String?
  deskripsi     String?
  gambarUrl     String?         @map("gambar_url")
  status        String          @default("aktif")
  urutan        Int?            @default(0)
  createdAt     DateTime?       @default(now()) @map("created_at") @db.Timestamptz(6)
  keberangkatan Keberangkatan[]

  @@index([kategori], map: "idx_paket_kategori")
  @@index([tier], map: "idx_paket_tier")
  @@map("paket")
}

model Keberangkatan {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paketId             String    @map("paket_id") @db.Uuid
  tanggalBerangkat    DateTime  @map("tanggal_berangkat") @db.Date
  durasiHari          Int?      @map("durasi_hari")
  lokasiKeberangkatan String?   @map("lokasi_keberangkatan")
  maskapaiId          String?   @map("maskapai_id") @db.Uuid
  hotelMekkahId       String?   @map("hotel_mekkah_id") @db.Uuid
  hotelMadinahId      String?   @map("hotel_madinah_id") @db.Uuid
  hargaNormal         Decimal   @map("harga_normal") @db.Decimal
  hargaPromo          Decimal?  @map("harga_promo") @db.Decimal
  kuotaTotal          Int       @default(0) @map("kuota_total")
  kuotaTersisa        Int       @default(0) @map("kuota_tersisa")
  status              String    @default("tersedia")
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  hotelMadinah        Hotel?    @relation("HotelMadinah", fields: [hotelMadinahId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hotelMekkah         Hotel?    @relation("HotelMekkah", fields: [hotelMekkahId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  maskapai            Maskapai? @relation(fields: [maskapaiId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paket               Paket     @relation(fields: [paketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bookings            Booking[]

  @@index([paketId], map: "idx_keberangkatan_paket")
  @@index([status], map: "idx_keberangkatan_status")
  @@index([tanggalBerangkat], map: "idx_keberangkatan_tanggal")
  @@map("keberangkatan")
}

model Artikel {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String    @unique
  judul           String
  ringkasan       String?
  konten          String
  kategori        String?
  gambarUrl       String?   @map("gambar_url")
  status          String    @default("draft")
  diterbitkanPada DateTime? @default(now()) @map("diterbitkan_pada") @db.Timestamptz(6)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([slug], map: "idx_artikel_slug")
  @@index([status], map: "idx_artikel_status")
  @@map("artikel")
}

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authId      String    @unique @map("auth_id") @db.Uuid
  email       String    @unique
  nama        String?
  role        String    @default("jamaah") // staff_admin | jamaah | agen
  noWhatsApp  String?   @map("no_whatsapp")
  alamat      String?
  photoUrl    String?   @map("photo_url")
  agenId      String?   @map("agen_id") @db.Uuid
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  agen        User?     @relation("AgenBinaan", fields: [agenId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  binaan      User[]    @relation("AgenBinaan")

  bookings     Booking[]

  @@index([role], map: "idx_user_role")
  @@index([agenId], map: "idx_user_agen")
  @@map("users")
}

model Booking {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  keberangkatanId   String    @map("keberangkatan_id") @db.Uuid
  status            String    @default("pending") // pending | confirmed | cancelled | completed
  catatan           String?
  jumlahBayar       Decimal?  @map("jumlah_bayar") @db.Decimal
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  keberangkatan   Keberangkatan @relation(fields: [keberangkatanId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_booking_user")
  @@index([keberangkatanId], map: "idx_booking_keberangkatan")
  @@index([status], map: "idx_booking_status")
  // CATATAN: partial unique index uniq_booking_aktif (satu booking aktif per
  // user+keberangkatan) TIDAK bisa dinyatakan di Prisma — dibuat manual via
  // supabase/migrations/20260830_bookings_unique_active.sql. Jangan hapus dari DB.
  @@map("bookings")
}

